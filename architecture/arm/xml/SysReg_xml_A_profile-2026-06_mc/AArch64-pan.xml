        <access_mechanism accessor="MRS PAN" type="SystemAccessor">
            <encoding>
            <access_instruction>MRS &lt;Xt&gt;, PAN</access_instruction>
                
                <enc n="op0" v="0b11"/>
                
                <enc n="op1" v="0b000"/>
                
                <enc n="CRn" v="0b0100"/>
                
                <enc n="CRm" v="0b0010"/>
                
                <enc n="op2" v="0b011"/>
            </encoding>
            <access_permission>
                <ps name="MRS" sections="1" secttype="access_permission">
                <pstext>
if !(IsFeatureImplemented(FEAT_PAN) &amp;&amp; IsFeatureImplemented(FEAT_AA64)) then
    Undefined();
elsif PSTATE.EL == EL0 then
    Undefined();
elsif PSTATE.EL == EL1 then
    X{64}(t) = Zeros{41} :: PSTATE.PAN :: Zeros{22};
elsif PSTATE.EL == EL2 then
    X{64}(t) = Zeros{41} :: PSTATE.PAN :: Zeros{22};
elsif PSTATE.EL == EL3 then
    X{64}(t) = Zeros{41} :: PSTATE.PAN :: Zeros{22};
end;
                </pstext>
                </ps>
            </access_permission>
        </access_mechanism>
    
        
        <access_mechanism accessor="MSRregister PAN" type="SystemAccessor">
