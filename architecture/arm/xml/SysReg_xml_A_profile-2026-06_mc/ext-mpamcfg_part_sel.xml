        <reg_long_name>MPAM Partition Configuration Selection Register</reg_long_name>

        <power_domain_text>The power domain of MPAMCFG_PART_SEL is <arm-defined-word>IMPLEMENTATION DEFINED</arm-defined-word></power_domain_text>


      
            <reg_condition otherwise="RES0">when (FEAT_MPAMv0p1 is implemented or FEAT_MPAMv1p0 is implemented) and (MPAMF_IDR.HAS_CCAP_PART == '1', or MPAMF_IDR.HAS_CPOR_PART == '1', or MPAMF_IDR.HAS_MBW_PART == '1', or MPAMF_IDR.HAS_PRI_PART == '1', or MPAMF_IDR.HAS_PARTID_NRW == '1', or (MPAMF_IDR.EXT == '0' and MPAMF_IDR.HAS_IMPL_IDR == '1'), or (MPAMF_IDR.EXT == '1', MPAMF_IDR.HAS_IMPL_IDR == '1', and MPAMF_IDR.NO_IMPL_PART == '0'))</reg_condition>
      

    
