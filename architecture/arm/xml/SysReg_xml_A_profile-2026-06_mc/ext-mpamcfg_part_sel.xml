      <reg_mappings>
        




      </reg_mappings>

        <reg_purpose>
          
    
      <purpose_text>
        <para>Selects a partition ID to configure.</para>

      </purpose_text>
      <purpose_text>
        <para>After setting this register with a PARTID, software (usually a hypervisor) can perform a series of accesses to MPAMCFG registers to configure parameters for MPAM resource controls to use when requests have that PARTID.</para>
      </purpose_text>

        </reg_purpose>

      <reg_groups>
          <reg_group>MPAM</reg_group>
      </reg_groups>
      <reg_configuration>
        
    
      <configuration_text>
        <para>If <xref linkend="#FEAT_MPAMv1p0">FEAT_MPAMv1p0</xref> or <xref linkend="#FEAT_MPAMv0p1">FEAT_MPAMv0p1</xref> is implemented, then the following statements apply:</para>

      </configuration_text>
      <configuration_text>
        <list type="unordered">
<listitem><content>
<para>MPAMCFG_PART_SEL_s selects a Secure PARTID to configure.</para>
</content>
</listitem><listitem><content>
<para>MPAMCFG_PART_SEL_ns selects a Non-secure PARTID to configure.</para>
</content>
</listitem><listitem><content>
<para>If <xref linkend="#FEAT_RME">FEAT_RME</xref> is implemented, then the following statements also apply:</para>
<list type="unordered">
<listitem><content>
<para>MPAMCFG_PART_SEL_rt selects a Root PARTID to configure.</para>
</content>
</listitem><listitem><content>
<para>MPAMCFG_PART_SEL_rl selects a Realm PARTID to configure.</para>
</content>
</listitem></list>
</content>
</listitem></list>

      </configuration_text>
      <configuration_text>
        <para>The power and reset domain of each MSC component is specific to that component.</para>
      </configuration_text>

      </reg_configuration>
      
      
        
      <reg_attributes>
          
    
      <attributes_text>
        <para>MPAMCFG_PART_SEL is a 32-bit register.</para>
      </attributes_text>

      </reg_attributes>
