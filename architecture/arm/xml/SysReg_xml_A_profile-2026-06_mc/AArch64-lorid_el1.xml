        <reg_purpose>
          
    
      <purpose_text>
        <para>Indicates the number of LORegions and LORegion descriptors supported by the PE.</para>
      </purpose_text>

        </reg_purpose>

      <reg_groups>
            <reg_group>Memory</reg_group>
            <reg_group>Identification Registers</reg_group>
      </reg_groups>
      <reg_configuration>
        
    
      <configuration_text>
        <para>If no LORegion descriptors are implemented, then the registers <register_link state="AArch64" id="AArch64-lorc_el1.xml">LORC_EL1</register_link>, <register_link state="AArch64" id="AArch64-lorn_el1.xml">LORN_EL1</register_link>, <register_link state="AArch64" id="AArch64-lorea_el1.xml">LOREA_EL1</register_link>, and <register_link state="AArch64" id="AArch64-lorsa_el1.xml">LORSA_EL1</register_link> are <arm-defined-word>RES0</arm-defined-word>.</para>
      </configuration_text>

      </reg_configuration>
      
      
        
      <reg_attributes>
          
    
      <attributes_text>
        <para>LORID_EL1 is a 64-bit register.</para>
      </attributes_text>

