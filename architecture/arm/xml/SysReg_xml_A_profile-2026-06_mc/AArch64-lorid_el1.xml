      <reg_short_name>LORID_EL1</reg_short_name>
        
        <reg_long_name>LORegionID (EL1)</reg_long_name>



      
            <reg_condition otherwise="UNDEFINED">when FEAT_LOR is implemented and FEAT_AA64 is implemented</reg_condition>
      




