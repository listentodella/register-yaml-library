        <reg_purpose>
          
    
      <purpose_text>
        <para>Used by software to set the CLAIM tag bits to 1.</para>

      </purpose_text>
      <purpose_text>
        <para>The architecture does not define any functionality for the CLAIM tag bits.</para>

      </purpose_text>
      <purpose_text>
        <note><para>CLAIM tags are typically used for communication between the debugger and target software.</para></note>
      </purpose_text>
      <purpose_text>
        <para>Used in conjunction with the <register_link state="AArch64" id="AArch64-dbgclaimclr_el1.xml">DBGCLAIMCLR_EL1</register_link> register.</para>
      </purpose_text>

        </reg_purpose>

      <reg_groups>
          <reg_group>Debug</reg_group>
      </reg_groups>
      <reg_configuration>
        
    
      <configuration_text>
        <para>An implementation must include eight CLAIM tag bits.</para>
      </configuration_text>

      </reg_configuration>
      
      
        
      <reg_attributes>
          
    
      <attributes_text>
        <para>DBGCLAIMSET_EL1 is a 64-bit register.</para>
