      <access_mechanisms>
          






    
        
        <access_mechanism accessor="MRS CNTFRQ_EL0" type="SystemAccessor">
            <encoding>
            <access_instruction>MRS &lt;Xt&gt;, CNTFRQ_EL0</access_instruction>
                
                <enc n="op0" v="0b11"/>
                
                <enc n="op1" v="0b011"/>
                
                <enc n="CRn" v="0b1110"/>
                
                <enc n="CRm" v="0b0000"/>
                
                <enc n="op2" v="0b000"/>
            </encoding>
            <access_permission>
                <ps name="MRS" sections="1" secttype="access_permission">
                <pstext>
if !IsFeatureImplemented(FEAT_AA64) then
    Undefined();
elsif EffectivelyAtEL0NotInHost() then
    if CNTKCTL_EL1().[EL0PCTEN,EL0VCTEN] == '00' then
        AArch64_SystemAccessTraptoEL1orEL2(0x18);
    else
        X{64}(t) = CNTFRQ_EL0();
    end;
elsif EffectivelyAtEL0InHost() then
    if CNTHCTL_EL2().[EL0PCTEN,EL0VCTEN] == '00' then
        AArch64_SystemAccessTrap(EL2, 0x18);
    else
        X{64}(t) = CNTFRQ_EL0();
    end;
elsif PSTATE.EL == EL1 then
    X{64}(t) = CNTFRQ_EL0();
elsif PSTATE.EL == EL2 then
    X{64}(t) = CNTFRQ_EL0();
elsif PSTATE.EL == EL3 then
    X{64}(t) = CNTFRQ_EL0();
end;
                </pstext>
                </ps>
            </access_permission>
        </access_mechanism>
    
        
        <access_mechanism accessor="MSRregister CNTFRQ_EL0" type="SystemAccessor">
            <encoding>
            <access_instruction>MSR CNTFRQ_EL0, &lt;Xt&gt;</access_instruction>
                
                <enc n="op0" v="0b11"/>
                
                <enc n="op1" v="0b011"/>
                
                <enc n="CRn" v="0b1110"/>
                
                <enc n="CRm" v="0b0000"/>
                
                <enc n="op2" v="0b000"/>
            </encoding>
            <access_permission>
                <ps name="MSRregister" sections="1" secttype="access_permission">
                <pstext>
if !IsFeatureImplemented(FEAT_AA64) then
    Undefined();
elsif IsHighestEL(PSTATE.EL) then
    CNTFRQ_EL0() = X{64}(t);
else
    Undefined();
end;
                </pstext>
                </ps>
            </access_permission>
        </access_mechanism>

