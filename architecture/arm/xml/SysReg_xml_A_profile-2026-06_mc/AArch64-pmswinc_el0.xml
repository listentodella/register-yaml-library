        <access_mechanism accessor="MSRregister PMSWINC_EL0" type="SystemAccessor">
            <encoding>
            <access_instruction>MSR PMSWINC_EL0, &lt;Xt&gt;</access_instruction>
                
                <enc n="op0" v="0b11"/>
                
                <enc n="op1" v="0b011"/>
                
