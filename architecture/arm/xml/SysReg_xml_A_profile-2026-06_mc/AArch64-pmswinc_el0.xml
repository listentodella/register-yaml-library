        <reg_purpose>
          
    
      <purpose_text>
        <para>Increments a counter that is configured to count the Software increment event, event <hexnumber>0x00</hexnumber>. For more information, see <xref linkend="#event.sw_incr">'SW_INCR'</xref>.</para>
      </purpose_text>

        </reg_purpose>

