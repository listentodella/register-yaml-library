      </field_value_instance>
      <field_value_instance>
        <field_value>0b1</field_value>
        <field_value_description>
          <para>Request power up of the Core power domain, and emulation of powerdown.</para>
        </field_value_description>
      </field_value_instance>
    </field_values>
