        <reg_purpose>
          
    
      <purpose_text>
        <para>Holds the value of the Virtualization Multiprocessor ID. This is the value returned by Non-secure EL1 reads of <register_link state="AArch32" id="AArch32-mpidr.xml">MPIDR</register_link>, which in a multiprocessor system, provides an additional PE identification system.</para>
      </purpose_text>

        </reg_purpose>

      <reg_groups>
            <reg_group>Virt</reg_group>
      </reg_groups>
      <reg_configuration>
        
    
      <configuration_text>
        <para>If EL2 is not implemented but EL3 is implemented, this register takes the value of the <register_link state="AArch32" id="AArch32-mpidr.xml">MPIDR</register_link>.</para>
      </configuration_text>

      </reg_configuration>
      
      
        
      <reg_attributes>
          
    
      <attributes_text>
        <para>VMPIDR is a 32-bit register.</para>
      </attributes_text>

      </reg_attributes>
