        <reg_purpose>
          
    
      <purpose_text>
        <para>Holds the saved process state for Debug state. On entering Debug state, PSTATE information is written to this register. On exiting Debug state, values are copied from this register to PSTATE.</para>
      </purpose_text>

        </reg_purpose>

