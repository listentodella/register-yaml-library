      </reg_fieldsets>

      <access_mechanisms>
          


  
    
      <access_permission_text>
        <para>This system instruction is an alias of the SYS instruction.</para>
      </access_permission_text>





    
        
        <access_mechanism accessor="GCSSS1" type="SystemAccessor">
            <encoding>
            <access_instruction>GCSSS1 &lt;Xt&gt;</access_instruction>
                
                <enc n="op0" v="0b01"/>
                
                <enc n="op1" v="0b011"/>
                
                <enc n="CRn" v="0b0111"/>
                
                <enc n="CRm" v="0b0111"/>
                
                <enc n="op2" v="0b010"/>
            </encoding>
            <access_permission>
                <ps name="GCSSS1" sections="1" secttype="access_permission">
                <pstext>
if !(IsFeatureImplemented(FEAT_GCS) &amp;&amp; IsFeatureImplemented(FEAT_AA64)) then
    Undefined();
elsif PSTATE.EL == EL0 then
    if GCSEnabled(EL0) then
        GCSSS1(X{64}(t));
    end;
elsif PSTATE.EL == EL1 then
    if GCSEnabled(EL1) then
        GCSSS1(X{64}(t));
    end;
elsif PSTATE.EL == EL2 then
    if GCSEnabled(EL2) then
        GCSSS1(X{64}(t));
    end;
elsif PSTATE.EL == EL3 then
    if GCSEnabled(EL3) then
        GCSSS1(X{64}(t));
    end;
end;
                </pstext>
                </ps>
            </access_permission>
        </access_mechanism>

      </access_mechanisms>

