    Undefined();
elsif HaveEL(EL3) &amp;&amp; PSTATE.EL == EL2 &amp;&amp; EL3SDDUndefPriority() &amp;&amp; SCR_EL3().HACDBSEn == '0' then
    Undefined();
elsif PSTATE.EL == EL0 then
