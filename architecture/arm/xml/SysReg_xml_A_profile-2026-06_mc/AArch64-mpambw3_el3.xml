      <reg_short_name>MPAMBW3_EL3</reg_short_name>
        
        <reg_long_name>MPAM PE-side Maximum Bandwidth Control Register (EL3)</reg_long_name>



      
            <reg_condition otherwise="UNDEFINED">when FEAT_MPAM_PE_BW_CTRL is implemented</reg_condition>
      




