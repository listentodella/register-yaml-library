      <configuration_text>
        <para>If <xref linkend="#FEAT_DoPD">FEAT_DoPD</xref> is implemented, this register is in the Core power domain. If <xref linkend="#FEAT_DoPD">FEAT_DoPD</xref> is not implemented, this register is in the Debug power domain.</para>
      </configuration_text>

      </reg_configuration>
      
      
        
