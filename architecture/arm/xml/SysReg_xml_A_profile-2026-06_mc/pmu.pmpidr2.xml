        <reg_purpose>
          
    
      <purpose_text>
        <para>Provides information to identify a Performance Monitor component.</para>

      </purpose_text>
      <purpose_text>
        <para>For more information, see <xref linkend="#BABDFHAH">'About the Peripheral identification scheme'</xref>.</para>
      </purpose_text>

        </reg_purpose>

      <reg_groups>
          <reg_group>PMU</reg_group>
      </reg_groups>
