        if EL3SDDUndef() then
            Undefined();
        else
            AArch64_SystemAccessTrap(EL3, 0x18);
        end;
    else
        ICC_SRE_EL2() = X{64}(t);
    end;
elsif PSTATE.EL == EL3 then
